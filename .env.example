# Supabase (required for cloud deployment)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=YOUR_ANON_KEY

# Optional: AI extraction (pick one)
TDS_OPENAI_API_KEY=
TDS_GEMINI_API_KEY=

# Public app URL used inside generated QR codes
PUBLIC_APP_URL=https://your-dpp-forge-url.onrender.com

# ConstructAsk QR target
CONSTRUCTASK_URL=https://constructask.vercel.app

# Optional demo seed for a fresh portfolio deployment
DEMO_SEED_ENABLED=false

# Comma-separated frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,https://your-dpp-forge-url.onrender.com

# Keep false unless you intentionally want delete enabled
ENABLE_PASSPORT_DELETE=false
